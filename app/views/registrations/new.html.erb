<% content_for :title, "アカウント作成 — kokoneads" %>
<div class="auth-page"><div class="auth-card"><%= link_to root_path, class: "auth-brand" do %><span class="brand-symbol">k</span><span>kokoneads</span><% end %><p class="eyebrow">YOUR WORKSPACE</p><h1>自分専用にする。</h1><p class="auth-copy">お気に入りと利用履歴を保存して、もっと早く使えるように。</p><%= render "shared/flash" %><% if @user.errors.any? %><div class="form-errors"><%= @user.errors.full_messages.join(" / ") %></div><% end %><%= form_with model: @user, url: signup_path, class: "auth-form" do |form| %><div class="field"><%= form.label :display_name, "表示名" %><%= form.text_field :display_name, required: true, autocomplete: "name", placeholder: "kokone user" %></div><div class="field"><%= form.label :email, "メールアドレス" %><%= form.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com" %></div><div class="field"><%= form.label :password, "パスワード" %><%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password", placeholder: "8文字以上" %></div><div class="field"><%= form.label :password_confirmation, "パスワード（確認）" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "もう一度入力" %></div><%= form.submit "アカウントを作成", class: "primary-button auth-submit" %><% end %><p class="auth-switch">すでに登録済み？ <%= link_to "ログイン", login_path %></p></div></div>
