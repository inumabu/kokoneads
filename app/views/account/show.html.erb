<% content_for :title, "マイワークスペース — kokoneads" %>
<%= render "tools/shell", active_slug: nil do %>
  <%= render "shared/flash" %>
  <section class="account-hero"><div><p class="eyebrow">MY WORKSPACE</p><h1><%= current_user.display_name %>さんの<br><span>作業スペース。</span></h1><p>お気に入りのツールと、最近の利用履歴。</p></div><div class="account-avatar"><%= current_user.display_name.first.upcase %></div></section>
  <div class="account-grid"><section class="account-panel"><div class="panel-heading"><div><p class="eyebrow">SAVED TOOLS</p><h2>お気に入り</h2></div><span><%= @saved_tools.size %> tools</span></div><% if @saved_tools.any? %><div class="saved-list"><% @saved_tools.each do |saved| %><% tool = @tools.find { |item| item[:slug] == saved.slug } %><%= link_to tool_path(saved.slug), class: "saved-row" do %><span class="tool-icon accent-<%= tool[:accent] %>"><%= tool[:icon] %></span><span><strong><%= tool[:name] %></strong><small><%= tool[:description] %></small></span><span class="row-arrow">↗</span><% end %><% end %></div><% else %><div class="empty-state"><span>☆</span><p>よく使うツールをお気に入りに<br>追加すると、ここに表示されます。</p><%= link_to "ツールを探す", root_path, class: "text-link" %></div><% end %></section><section class="account-panel"><div class="panel-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>最近使ったツール</h2></div></div><% if @recent_histories.any? %><div class="history-list"><% @recent_histories.each do |history| %><% tool = @tools.find { |item| item[:slug] == history.slug } %><div class="history-row"><span class="history-dot"></span><span><strong><%= tool ? tool[:name] : history.slug %></strong><small><%= history.created_at.strftime("%Y.%m.%d %H:%M") %></small></span></div><% end %></div><% else %><div class="empty-state"><span>◷</span><p>ツールを使うと、最近の履歴が<br>ここに表示されます。</p></div><% end %></section></div>
  <section class="account-security"><div><p class="eyebrow">ACCOUNT</p><h2>アカウント設定</h2><p><%= current_user.email %></p></div><%= button_to "ログアウト", logout_path, method: :delete, class: "secondary-button" %></section>
<% end %>
