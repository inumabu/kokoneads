<% content_for :title, "ログイン — kokoneads" %>
<div class="auth-page"><div class="auth-card"><%= link_to root_path, class: "auth-brand" do %><span class="brand-symbol">k</span><span>kokoneads</span><% end %><p class="eyebrow">WELCOME BACK</p><h1>おかえりなさい。</h1><p class="auth-copy">お気に入りのツールと履歴を、いつもの場所から。</p><%= render "shared/flash" %><%= form_with url: login_path, class: "auth-form" do |form| %><div class="field"><%= form.label :email, "メールアドレス" %><%= form.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com" %></div><div class="field"><%= form.label :password, "パスワード" %><%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••" %></div><%= form.submit "ログイン", class: "primary-button auth-submit" %><% end %><p class="auth-switch">はじめてですか？ <%= link_to "アカウントを作る", signup_path %></p></div></div>
